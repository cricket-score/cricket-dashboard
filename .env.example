# Local login and initial Supabase scorer provisioning only. Never publish this.
# The provisioning script generates a strong password if this is under 12 characters.
ADMIN_PASSWORD=
# Generate with: openssl rand -hex 32
SESSION_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Local development only: file persistence, no database account needed.
LOCAL_DEMO=true
# GitHub Pages sets this automatically during build: no Next.js server required.
# Set it locally to test the deployed Supabase function from npm run dev.
NEXT_PUBLIC_BACKEND=
# Optional: defaults to scorer@boundary.invalid (not an email recipient).
NEXT_PUBLIC_SCORER_EMAIL=
# Pages project URL prefix, e.g. /cricket-dashboard. Empty for localhost.
NEXT_PUBLIC_BASE_PATH=
